@using System.Globalization

<section class="blog">
    <div class="container">
        <header class="page-head blog-header">
            <span class="overline">Blogg</span>

            @if (Max.HasValue)
            {
                <a class="view-all" href="/blog" aria-label="Visa alla inlägg">
                    Visa alla inlägg →
                </a>
            }
        </header>

        <div class="blog-grid">
            @foreach (var p in Visible)
            {
                <article class="post-card">
                    <time datetime="@p.PublishedAt.ToString("yyyy-MM-dd")" class="post-date">
                        @FormatDate(p.PublishedAt)
                    </time>

                    <h3 class="post-title">@p.Title</h3>

                    @if (!string.IsNullOrWhiteSpace(p.Excerpt))
                    {
                        <p class="post-excerpt">@p.Excerpt</p>
                    }

                    <a class="post-cta" href="@p.Slug" aria-label="Läs artikeln: @p.Title">
                        Läs artikeln <span aria-hidden="true">›</span>
                    </a>
                </article>
            }
        </div>
    </div>
</section>

@code {

    [Parameter] public int? Max { get; set; }

    private IEnumerable<PostItem> Visible
    {
        get
        {
            var ordered = posts.OrderByDescending(p => p.PublishedAt);
            if (Max.HasValue) return ordered.Take(Max.Value);
            return ordered;
        }
    }

    private static string FormatDate(DateTime dt) =>
        dt.ToString("d MMMM yyyy", new CultureInfo("sv-SE"));

    private readonly List<PostItem> posts = new()
    {
        new PostItem{
            Title="Förståelse för containers och nätverk",
            Excerpt="Den fjärde veckan fokuserade jag på att fördjupa förståelsen för hur containers, nätverk och automatiserad bygg- och deployprocess fungerar i praktiken med GitLab, Kaniko och Argo CD. ",
            Slug="/blog/lia-vecka-4",
            PublishedAt=new DateTime(2025,10,13)
        },
        new PostItem{
            Title="Fördjupning i Argo CD och applikationshantering",
            Excerpt="Under den tredje veckan på praktiken fördjupade jag mig i hur Argo CD fungerar på djupet och hur GitOps-flödet styr deployment-processen i Kubernetes. ",
            Slug="/blog/lia-vecka-3",
            PublishedAt=new DateTime(2025,10,06)
        },
        new PostItem{
            Title="Vecka 2 på LIA – praktiska labbar i KodeKloud",
            Excerpt="Under andra veckan fokuserade jag på att fördjupa mina kunskaper genom interaktiva labbar i KodeKloud och genom att bli mer bekväm i Linuxmiljön.",
            Slug="/blog/lia-vecka-2",
            PublishedAt=new DateTime(2025,09,29)
        },
        new PostItem{
            Title="Min första vecka på LIA hos Bonfire Cloud & Engineering",
            Excerpt="Den första veckan handlade om att komma igång med projektet: att bygga en Software Factory i en Kubernetes-miljö. Här är vad jag gjorde, lärde mig och reflekterade över. ",
            Slug="/blog/lia-vecka-1",
            PublishedAt=new DateTime(2025,09,22)
        },
    };

    public class PostItem
    {
        public string Title { get; set; } = "";
        public string Excerpt { get; set; } = "";
        public string Slug { get; set; } = "";
        public DateTime PublishedAt { get; set; }
    }
}
