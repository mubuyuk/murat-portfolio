<section class="projects-section">
    <div class="projects-container">

        <div class="projects-header">
            <span class="overline">Projekt</span>

            @if (Max.HasValue)
            {
                <a class="view-all" href="/projects" aria-label="Visa alla projekt">
                    Visa alla projekt →
                </a>
            }
        </div>

        <div class="projects-list">
            @foreach (var p in Visible)
            {
                <article class="project-card">
                    <a class="project-link-wrapper"
                       href="@p.Slug"
                       aria-label="Visa mer om @p.Title">

                        @if (!string.IsNullOrWhiteSpace(p.GitHubUrl))
                        {
                            <a class="gh-link"
                               href="@p.GitHubUrl"
                               target="_blank"
                               rel="noopener"
                               aria-label="Öppna GitHub för @p.Title"
                               @onclick:stopPropagation="true">
                                <i class="bi bi-github"></i>
                            </a>
                        }

                        <div class="card-grid">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <div class="card-media">
                                    <img src="@p.ImageUrl" alt="" loading="lazy" decoding="async" />
                                </div>
                            }

                            <div class="card-body">
                                <h3 class="project-title">@p.Title</h3>
                                <p class="project-summary">@p.Summary</p>

                                <ul class="pills tech-pills" aria-label="Tekniker">
                                    @foreach (var t in p.Tech)
                                    {
                                        <li>@t</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </a>
                </article>

            }
        </div>
    </div>
</section>

@code {
    private List<ProjectItem> projects = new()
    {
        new ProjectItem {
            Title = "Software Factory",
            Slug = "/projects/software-factory",
            Summary = "En DevOps-plattform byggd från grunden i Kubernetes med GitLab, Argo CD och automatiserade pipelines. Ett LIA-projekt där jag lärde mig hur modern utveckling och drift hänger ihop.",
            Tech = new() { "Kubernetes (k3s)", "Argo CD", "GitOps", "GitLab CI/CD", "GitLab Runner" },
            ImageUrl = "/images/project_bonfire_logo.png",
            GitHubUrl = "#"
        },
        new ProjectItem {
            Title = "Blazor WebAssembly Portfolio",
            Slug = "/projects/blazor-portfolio",
            Summary = "Portfoliosida där jag bygger upp min frontend i Blazor WebAssembly med C# och .NET. Projektet hostas i Azure och är förberett för att senare kunna kopplas mot Azure Functions och en databas.",
            Tech = new() { "Blazor WebAssembly", "C#", ".NET", "Azure" },
            ImageUrl = "/images/project_portfolio_logo.png",
            GitHubUrl = "https://github.com/mubuyuk/portfolio-blazor"
        },
};

    public class ProjectItem
    {
        public string Title { get; set; } = "";
        public string Slug { get; set; } = "";
        public string Summary { get; set; } = "";
        public List<string> Tech { get; set; } = new();
        public string? ImageUrl { get; set; }
        public string? GitHubUrl { get; set; }
    }

    [Parameter] public int? Max { get; set; }

    private IEnumerable<ProjectItem> Visible
    {
        get
        {
            if (Max.HasValue)
                return projects.Take(Max.Value);
            return projects;
        }
    }
}
