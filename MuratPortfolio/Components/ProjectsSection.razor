<section class="projects-section">
    <div class="projects-container">

        <div class="projects-header">
            @if (PageHeading)
            {
                <h1 class="overline">Projekt</h1>
            }
            else
            {
                <h2 class="overline">Projekt</h2>
            }

            @if (ShowAllLink)
            {
                <a class="view-all" href="/projects" aria-label="Visa alla projekt">
                    Visa alla projekt →
                </a>
            }
        </div>

        <div class="projects-list">
            @foreach (var p in Visible)
            {
                <article class="project-card">
                    <div class="card-grid">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <div class="card-media">
                                <img src="@p.ImageUrl" alt="" loading="lazy" decoding="async" />
                            </div>
                        }

                        <div class="card-body">
                            <!-- Länken täcker hela kortet via ::after -->
                            @if (PageHeading)
                            {
                                <h2 class="project-title">@TitleLink(p)</h2>
                            }
                            else
                            {
                                <h3 class="project-title">@TitleLink(p)</h3>
                            }
                            <p class="project-summary">@p.Summary</p>

                            <ul class="pills tech-pills" aria-label="Tekniker">
                                @foreach (var t in p.Tech)
                                {
                                    <li>@t</li>
                                }
                            </ul>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(p.GitHubUrl))
                    {
                        <a class="gh-link"
                           href="@p.GitHubUrl"
                           target="_blank"
                           rel="noopener"
                           aria-label="Öppna GitHub för @p.Title">
                            <i class="bi bi-github"></i>
                        </a>
                    }
                </article>

            }
        </div>
    </div>
</section>

@code {
    private List<ProjectItem> projects = new()
    {
        new ProjectItem {
            Title = "Homelab / Raspberry Pi",
            Slug = "/projects/homelab",
            Summary = "Linux-baserat homelab på Raspberry Pi där jag driver containeriserade tjänster och arbetar praktiskt med Docker, nätverk, lokal DNS och reverse proxy.",
            Tech = new() { "Linux", "Docker", "Docker Compose", "DNS", "Reverse Proxy" },
            ImageUrl = "/images/project_homelab_placeholder.svg",
            GitHubUrl = null
        },
        new ProjectItem {
            Title = "Software Factory",
            Slug = "/projects/software-factory",
            Summary = "LIA-projekt på Bonfire Cloud & Engineering där vi satte upp en mindre Software Factory-miljö i Kubernetes (k3s), med GitLab CI/CD och Argo CD/GitOps för att bygga och deploya applikationer.",
            Tech = new() { "Kubernetes (k3s)", "Argo CD", "GitOps", "GitLab CI/CD", "GitLab Runner" },
            ImageUrl = "/images/project_bonfire_logo.png",
            GitHubUrl = null
        },
        new ProjectItem {
            Title = "Blazor WebAssembly Portfolio",
            Slug = "/projects/blazor-portfolio",
            Summary = "Portfoliosida byggd med Blazor WebAssembly och .NET, med responsiv design. Sidan hostas i Azure Static Web Apps och använder GitHub Actions för deployment.",
            Tech = new() { "Blazor WebAssembly", "C#", ".NET", "Azure" },
            ImageUrl = "/images/project_portfolio_logo.png",
            GitHubUrl = "https://github.com/mubuyuk/murat-portfolio"
        },
};

    public class ProjectItem
    {
        public string Title { get; set; } = "";
        public string Slug { get; set; } = "";
        public string Summary { get; set; } = "";
        public List<string> Tech { get; set; } = new();
        public string? ImageUrl { get; set; }
        public string? GitHubUrl { get; set; }
    }

    // Max begränsar antalet kort. ShowAllLink styr separat om "Visa alla projekt" visas.
    [Parameter] public int? Max { get; set; }
    [Parameter] public bool ShowAllLink { get; set; }

    // Sätts på /projects: "Projekt" blir sidans H1 och korttitlarna H2.
    // Annars (startsidan) ligger sektionen under sidans egen H1: "Projekt" är H2 och korttitlarna H3.
    [Parameter] public bool PageHeading { get; set; }

    private RenderFragment<ProjectItem> TitleLink => p =>
        @<a class="project-link" href="@p.Slug">@p.Title</a>;

    private IEnumerable<ProjectItem> Visible
    {
        get
        {
            if (Max.HasValue)
                return projects.Take(Max.Value);
            return projects;
        }
    }
}
